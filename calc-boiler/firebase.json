{
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "regex": "/tax-on-([0-9]+)/?",
        "destination": "/tax-on/:1/index.html"
      }
    ],
    "redirects": [
      {
        "source": "/tax-on/40,000-salary/",
        "destination": "/tax-on/40000/",
        "type": 301
      },
      {
        "source": "/tax-on/50,000-salary/",
        "destination": "/tax-on/50000/",
        "type": 301
      },
      {
        "source": "/tax-on/60,000-salary/",
        "destination": "/tax-on/60000/",
        "type": 301
      },
      {
        "source": "/tax-on/70,000-salary/",
        "destination": "/tax-on/70000/",
        "type": 301
      },
      {
        "source": "/tax-on/80,000-salary/",
        "destination": "/tax-on/80000/",
        "type": 301
      },
      {
        "source": "/tax-on/90,000-salary/",
        "destination": "/tax-on/90000/",
        "type": 301
      },
      {
        "source": "/tax-on/100,000-salary/",
        "destination": "/tax-on/100000/",
        "type": 301
      },
      {
        "source": "/tax-on/120,000-salary/",
        "destination": "/tax-on/120000/",
        "type": 301
      },
      {
        "source": "/tax-on/150,000-salary/",
        "destination": "/tax-on/150000/",
        "type": 301
      },
      {
        "source": "/tax-on/200,000-salary/",
        "destination": "/tax-on/200000/",
        "type": 301
      },
      {
        "source": "/medicare-levy-calculator/",
        "destination": "/medicare-levy/",
        "type": 301
      },
      {
        "source": "/pay-calculater/",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/pay-calcualtor/",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/superannuation-calcualtor/",
        "destination": "/superannuation-calculator/",
        "type": 301
      },
      {
        "source": "/calculator/",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/tax/",
        "destination": "/tax-brackets/",
        "type": 301
      },
      {
        "source": "/super/",
        "destination": "/superannuation-calculator/",
        "type": 301
      },
      {
        "source": "/tax-brackets-2024-25/",
        "destination": "/tax-brackets/",
        "type": 301
      },
      {
        "source": "/tax-brackets-2025-26/",
        "destination": "/tax-brackets/",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-DNS-Prefetch-Control", "value": "on" },
          { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
        ]
      },
      {
        "source": "**/*.@(js|css|svg|png|jpg|jpeg|webp|avif|woff2)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ],
    "cleanUrls": true,
    "trailingSlash": true
  }
}
